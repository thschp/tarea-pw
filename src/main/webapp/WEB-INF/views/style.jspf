<%@ page pageEncoding="UTF-8" %>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
<style>
	* {
		box-sizing: border-box;
	}
 
	:root {
		--ink: #17252a;
		--muted: #708083;
		--line: #dfe8e5;
		--cream: #f5f8f5;
		--mint: #d9f2e7;
		--green: #1d735f;
		--orange: #ed7650;
		--white: #fff;
	}
 
	body {
		margin: 0;
		background: var(--cream);
		color: var(--ink);
		font-family: 'DM Sans', sans-serif;
	}
 
	h1 {
		margin: 0 0 22px;
		font-family: 'Space Grotesk', sans-serif;
		font-size: 28px;
		font-weight: 600;
		letter-spacing: -.05em;
	}
 
	p {
		line-height: 1.6;
	}
 
	a {
		color: var(--green);
		font-weight: 700;
	}
 
 
	.barra {
		height: 76px;
		padding: 0 7vw;
		display: flex;
		justify-content: space-between;
		align-items: center;
		border-bottom: 1px solid var(--line);
		color: var(--muted);
		font-size: 13px;
	}
 
	.barra strong {
		color: var(--ink);
	}
 
	.barra a {
		font-size: 13px;
		text-decoration: none;
	}
 
	.marca {
		display: flex;
		align-items: center;
		gap: 10px;
		color: var(--ink);
		font-family: 'Space Grotesk', sans-serif;
		font-size: 19px;
		font-weight: 700;
		letter-spacing: -.04em;
	}
 
	.marca span {
		display: grid;
		place-items: center;
		width: 29px;
		height: 29px;
		background: var(--green);
		border-radius: 9px 9px 9px 2px;
		color: var(--white);
		font-size: 15px;
	}
 
 
	.contenedor {
		max-width: 860px;
		margin: 50px auto;
		padding: 0 16px;
	}
 
	.tarjeta {
		padding: 34px;
		background: var(--white);
		border: 1px solid var(--line);
		border-radius: 8px;
	}
 
	.centro {
		max-width: 400px;
		margin: 80px auto;
	}
 
	.centrado {
		text-align: center;
	}
 
 
	label {
		display: block;
		margin: 18px 0 8px;
		font-size: 11px;
		font-weight: 700;
	}
 
	input[type=text],
	input[type=password],
	input[type=number] {
		width: 100%;
		padding: 12px;
		background: var(--white);
		border: 1px solid var(--line);
		border-radius: 5px;
		color: var(--ink);
		font: inherit;
		outline: none;
	}
 
	input:focus {
		border-color: var(--green);
	}
 
 
	.btn {
		display: inline-block;
		padding: 14px 19px;
		background: var(--green);
		border: 0;
		border-radius: 6px;
		color: var(--white);
		cursor: pointer;
		font-family: 'DM Sans', sans-serif;
		font-size: 13px;
		font-weight: 700;
		text-decoration: none;
		transition: .2s;
	}
 
	.btn:hover {
		transform: translateY(-2px);
	}
 
	.btn.gris {
		background: transparent;
		border: 1px solid var(--line);
		color: var(--ink);
	}
 
	.btn.suave {
		background: var(--mint);
		color: var(--green);
	}
 
	.btn.peligro {
		background: #fff8f4;
		color: #fc3503;
	}
 
	.btn.pequeno {
		padding: 8px 11px;
		font-size: 11px;
	}
 
	.completo {
		width: 100%;
		margin-top: 26px;
	}
 
	.acciones {
		margin-top: 22px;
	}
 
 
	table {
		width: 100%;
		margin: 6px 0 26px;
		border-collapse: collapse;
		font-size: 14px;
	}
 
	th,
	td {
		padding: 12px;
		border-bottom: 1px solid var(--line);
		text-align: left;
	}
 
	th {
		color: var(--green);
		font-size: 11px;
	}
 
 	.en-linea {
	display: inline;
	}
	
	.alerta {
		margin-bottom: 14px;
		padding: 11px 14px;
		font-size: 12px;
	}
 
	.alerta.error {
		background: #fff8f4;
		border-left: 3px solid var(--orange);
		color: #c0503b;
	}
 
	.alerta.ok {
		background: var(--mint);
		border-left: 3px solid var(--green);
	}
 
	.hint {
		margin-top: 12px;
		color: var(--muted);
		font-size: 11px;
		line-height: 1.5;
	}
 
 
	.codigo {
		margin: 0;
		color: var(--orange);
		font-family: 'Space Grotesk', sans-serif;
		font-size: 80px;
		font-weight: 600;
		letter-spacing: -.06em;
		line-height: 1;
	}
 
	.codigo + h1 {
		margin-top: 14px;
	}
</style>